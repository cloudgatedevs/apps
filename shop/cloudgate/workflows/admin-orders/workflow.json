{
  "name": "Admin Orders",
  "route": "admin-orders",
  "method": "POST",
  "allowAnonymous": false,
  "enableLogging": true,
  "description": "Back office orders: list/get, status changes with tracking and customer notifications, and notes. Refunds use /refunds with a stable requestKey. Requires IdP admin.",
  "entry": "IdpAuth",
  "nodes": [
    {
      "name": "IdpAuth",
      "type": "idp",
      "output": "userInfo",
      "allowAnonymous": false,
      "next": "Plan",
      "role": "Admin"
    },
    {
      "name": "Plan",
      "type": "function",
      "script": "plan.py",
      "next": "Run"
    },
    {
      "name": "Run",
      "type": "database",
      "script": "run.sql",
      "next": "IsStatusChange"
    },
    {
      "name": "Shape",
      "type": "function",
      "script": "shape.py"
    },
    {
      "name": "IsStatusChange",
      "type": "condition",
      "script": "is_status_change.py",
      "positive": "StatusEvent",
      "negative": "Shape"
    },
    {
      "name": "StatusEvent",
      "type": "function",
      "script": "status_event.py",
      "next": "NotifyStatus",
      "thread": "EmailSettings"
    },
    {
      "name": "NotifyStatus",
      "type": "websocket",
      "channel": "shop-events",
      "body": "${StatusEvent}",
      "next": "Shape"
    },
    {
      "name": "EmailSettings",
      "type": "database",
      "script": "../_shared/email_settings.sql",
      "next": "OrderEmail"
    },
    {
      "name": "OrderEmail",
      "type": "function",
      "script": "../_shared/status_email.py",
      "next": "SendEmail"
    },
    {
      "name": "SendEmail",
      "type": "function",
      "script": "../_shared/send_email.py"
    }
  ]
}
