    },
    {
      "name": "Plan",
      "type": "function",
      "script": "plan.py",
      "next": "Run"
    },
    {
      "name": "Run",
      "type": "database",
      "script": "run.sql",
      "next": "Shape"
    },
    {
      "name": "Shape",
      "type": "function",
      "script": "shape.py"
    }
  ]
}
