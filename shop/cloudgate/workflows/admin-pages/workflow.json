{
  "name": "Admin Pages",
  "route": "admin-pages",
  "method": "POST",
  "allowAnonymous": false,
  "enableLogging": true,
  "description": "Back office content pages (terms, privacy, about \u2026): list, get, create, update, delete (non-system only), reorder. Requires API key + IdP admin.",
