{
  "name": "cloudgate-shop",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "cloudgate:deploy": "python cloudgate/deploy.py",
    "cloudgate:list": "python cloudgate/deploy.py --list",
    "cloudgate:smoke": "python cloudgate/smoke.py",
    "banner": "node scripts/banner.mjs",
    "test:refunds": "python -B -X utf8 cloudgate/test_refunds.py && node --test tests/refunds-client.mjs",
    "cloudgate:package-refunds": "python -B -X utf8 cloudgate/package_refunds.py"
  },
  "dependencies": {
    "@cloudgatedevs/cloudgate-client": "^0.5.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@uppy/core": "^4.5.3",
    "@uppy/dashboard": "^4.4.3",
    "@uppy/drag-drop": "^4.2.2",
    "@uppy/file-input": "^4.2.2",
    "@uppy/progress-bar": "^4.3.2",
    "@uppy/react": "^4.5.2",
    "@uppy/status-bar": "^4.2.3",
    "@uppy/webcam": "^4.3.2",
    "@uppy/xhr-upload": "^4.4.2",
    "dompurify": "^3.4.14",
    "lucide-react": "^1.41.0",
    "marked": "^18.0.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-easy-crop": "^6.2.3",
    "react-router-dom": "^6.28.0",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.14",
    "vite": "^5.4.11",
    "playwright": "^1.47.0"
  }
}
