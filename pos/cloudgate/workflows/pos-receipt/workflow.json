{
  "name": "POS Receipt",
  "route": "pos-receipt",
  "method": "POST",
  "allowAnonymous": false,
  "enableLogging": true,
  "description": "email (saleId, to): sends the receipt on a thread branch through Cloudgate tenant email delivery. IdP teller role.",
  "entry": "IdpAuth",
  "nodes": [
    {
      "name": "IdpAuth",
      "type": "idp",
      "output": "userInfo",
      "allowAnonymous": false,
      "next": "Plan"
    },
    {
      "name": "Plan",
      "type": "function",
      "script": "plan.py",
      "next": "Run"
    },
    {
      "name": "Run",
      "type": "database",
      "script": "run.sql",
      "next": "Shape",
      "thread": "EmailSettings"
    },
    {
      "name": "Shape",
      "type": "function",
      "script": "shape.py"
    },
    {
      "name": "EmailSettings",
      "type": "database",
      "script": "email_settings.sql",
      "next": "OrderEmail"
    },
    {
      "name": "OrderEmail",
      "type": "function",
      "script": "receipt_email.py",
      "next": "SendEmail"
    },
    {
      "name": "SendEmail",
      "type": "function",
      "script": "../_shared/send_email.py"
    }
  ]
}
