{
  "name": "Admin Sales",
  "route": "admin-sales",
  "method": "POST",
  "allowAnonymous": false,
  "enableLogging": true,
  "description": "Back office sales: list/get and void open or held sales. Refunds use /refunds with a stable requestKey. Requires IdP admin.",
  "entry": "IdpAuth",
  "nodes": [
    {
      "name": "IdpAuth",
      "type": "idp",
      "output": "userInfo",
      "allowAnonymous": false,
      "next": "Plan",
      "role": "Admin"
    },
    {
      "name": "Plan",
      "type": "function",
      "script": "plan.py",
      "next": "Load"
    },
    {
      "name": "Load",
      "type": "database",
      "script": "load.sql",
      "next": "Compute"
    },
    {
      "name": "Compute",
      "type": "function",
      "script": "compute.py",
      "next": "Run"
    },
    {
      "name": "Run",
      "type": "database",
      "script": "run.sql",
      "next": "Shape"
    },
    {
      "name": "Shape",
      "type": "function",
      "script": "shape.py"
    }
  ]
}
