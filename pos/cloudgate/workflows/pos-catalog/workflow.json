{
  "name": "POS Catalog",
  "route": "pos-catalog",
  "method": "POST",
  "allowAnonymous": false,
  "enableLogging": true,
  "description": "Teller lookups: 'settings' (till settings), 'categories', 'products' (grid/search), 'lookup' (barcode, alias barcode or SKU -> one product). IdP teller role.",
  "entry": "IdpAuth",
  "nodes": [
    {
      "name": "IdpAuth",
      "type": "idp",
      "output": "userInfo",
      "allowAnonymous": false,
      "next": "Plan"
    },
    {
      "name": "Plan",
      "type": "function",
      "script": "plan.py",
      "next": "Run"
    },
    {
      "name": "Run",
      "type": "database",
      "script": "run.sql",
      "next": "Shape"
    },
    {
      "name": "Shape",
      "type": "function",
      "script": "shape.py"
    }
  ]
}
