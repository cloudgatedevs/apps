{
  "name": "Admin Tellers",
  "route": "admin-tellers",
  "method": "POST",
  "allowAnonymous": false,
  "enableLogging": true,
  "description": "Back office tellers: who has used the till, with shift and sales totals (users and roles are managed in the Cloudgate hub). IdP admin.",
  "entry": "IdpAuth",
  "nodes": [
    {
      "name": "IdpAuth",
      "type": "idp",
      "output": "userInfo",
      "allowAnonymous": false,
      "next": "Plan",
      "role": "Admin"
    },
    {
      "name": "Plan",
      "type": "function",
      "script": "plan.py",
      "next": "Run"
    },
    {
      "name": "Run",
      "type": "database",
      "script": "run.sql",
      "next": "Shape"
    },
    {
      "name": "Shape",
      "type": "function",
      "script": "shape.py"
    }
  ]
}
