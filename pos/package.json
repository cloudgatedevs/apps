{
  "name": "cloudgate-pos",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "cloudgate:deploy": "python cloudgate/deploy.py",
    "cloudgate:list": "python cloudgate/deploy.py --list",
    "cloudgate:smoke": "python cloudgate/smoke.py",
    "banner": "node scripts/banner.mjs",
    "test:refunds": "python -B -X utf8 cloudgate/test_refunds.py && node --test tests/refunds-client.mjs",
    "cloudgate:package-refunds": "python -B -X utf8 cloudgate/package_refunds.py",
    "cloudgate:package-email": "python -B -X utf8 cloudgate/package_email.py",
    "test": "npm run test:refunds && node --test tests/*.test.mjs",
    "test:ui": "node tests/sdk.browser.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@uppy/core": "^4.5.3",
    "@uppy/dashboard": "^4.4.3",
    "@uppy/react": "^4.5.2",
    "@uppy/webcam": "^4.3.2",
    "@zxing/browser": "^0.1.5",
    "@zxing/library": "^0.21.3",
    "jsbarcode": "^3.11.6",
    "lucide-react": "^1.41.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-easy-crop": "^6.2.3",
    "react-router-dom": "^6.30.6",
    "sonner": "^2.0.8",
    "@cloudgatedevs/cloudgate-client-react": "^0.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.20",
    "globals": "^17.12.0",
    "playwright": "^1.47.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.14",
    "vite": "^8.3.1"
  },
  "description": "Point of sale on Cloudgate: camera barcode scanning, cash and Cloudgate Wallet payments, shifts and a full inventory back office."
}
