# Cloudgate App Store substitutes these placeholders during installation.
# Local preview: npm run dev:api and npm run dev:preview (works with or without .env).
VITE_CLOUDGATE_API_URL={{workflowGatewayUrl}}
VITE_CLOUDGATE_API_ENV={{environment}}
VITE_CLOUDGATE_API_PROJECT={{projectPath}}
VITE_API_KEY={{apiKey}}
VITE_API_SECRET={{apiSecret}}
VITE_IDP_BASE_URL={{hubUrl}}
VITE_IDP_API_URL={{apiUrl}}
VITE_IDP_TENANCY_NAME={{tenancyName}}
# Rollout injects this environment's web app ID. Use your local app ID for connected development.
VITE_CLOUDGATE_WEB_APP_ID={{webAppId}}
